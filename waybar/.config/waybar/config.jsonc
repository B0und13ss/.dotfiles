{
  "reload_style_on_change": true,
  "layer": "bottom",
  "position": "top",
  "height": 32,
  "margin": "4 4 0 4",

  "modules-left": ["custom/arch", "hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["tray", "mpris", "pulseaudio", "network", "clock"],

  "custom/arch": {
    "format": "󰣇",
    "tooltip": false,
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "disable-scroll": true,
  },
  "hyprland/window": {
    "max-length": 80,
    "tooltip": false,
  },
  "clock": {
    "format": "{:%a %d %b %H:%M:%S}",
    "tooltip": false,
    "interval": 1,
    "on-click": "gnome-clocks",
  },
  "network": {
    "format": "{icon}",
    "format-alt": "{ipaddr}/{cidr} {icon}",
    "format-alt-click": "click-right",
    "format-icons": {
      "wifi": ["󰤟", "󰤢", "󰤥", "󰤨"],
      "ethernet": ["󰈀"],
      "disconnected": ["󰤭"],
    },
    "on-click": "kitty -e nmtui",
    "tooltip": false,
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-alt": "{volume} {icon}",
    "format-alt-click": "click-right",
    "format-muted": "",
    "format-icons": {
      "phone": [" ", " ", " "],
      "default": ["", "", ""],
    },
    "scroll-step": 10,
    "on-click": "pavucontrol",
    "tooltip": false,
  },
  "mpris": {
    "format": "{player_icon}  {title}",
    "format-paused": "{player_icon}  {title}",
    "format-stopped": "",
    "player-icons": {
      "spotify": "",
      "chromium": "",
    },
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "ignored-players": ["mpv"],
    "tooltip": false,
  },
  "tray": {
    "icon-size": 18,
  },
}
