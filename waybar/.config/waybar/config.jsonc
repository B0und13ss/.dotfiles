{
  "reload_style_on_change": true,
  "layer": "bottom",
  "position": "top",
  "height": 32,
  "margin": "4 4 0 4",

  "modules-left": ["custom/arch", "hyprland/workspaces", "mpris"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["group/tray", "clock"],

  "group/tray": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 250
    },
    "modules": [
      "custom/tray-icon",
      "tray",
      "pulseaudio",
      "network"
    ]
  },
  "custom/tray-icon": {
    "format": "",
    "tooltip": false
  },
  "custom/arch": {
    "format": "󰣇",
    "tooltip": false
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "disable-scroll": true
  },
  "hyprland/window": {
    "max-length": 80,
    "tooltip": false
  },
  "clock": {
    "format": "{:%a %d %b %H:%M:%S}",
    "tooltip": false,
    "interval": 1,
    "on-click": "gnome-clocks"
  },
  "network": {
    "format": "{icon}",
    "format-alt": "{ipaddr}/{cidr} {icon}",
    "format-alt-click": "click-right",
    "format-icons": {
      "wifi": ["󰤟", "󰤢", "󰤥", "󰤨"],
      "ethernet": ["󰈀"],
      "disconnected": ["󰤭"]
    },
    "on-click": "kitty -e nmtui",
    "tooltip": false
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-alt": "{volume} {icon}",
    "format-alt-click": "click-right",
    "format-muted": "",
    "format-icons": {
      "phone": [" ", " ", " "],
      "default": ["", "", ""]
    },
    "scroll-step": 10,
    "on-click": "pavucontrol",
    "tooltip": false
  },
  "mpris": {
    "format": "{player_icon} {artist} - {title}",
    "format-paused": "{player_icon}  {title}",
    "format-stopped": "",
    "player-icons": {
      "spotify": "",
      "chromium": ""
    },
    "on-click": "playerctl play-pause",
    "on-right-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "ignored-players": ["mpv"],
    "tooltip": false
  }
}
