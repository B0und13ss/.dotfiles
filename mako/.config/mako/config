font=Noto Sans 10

text-color=#dfe4f7
background-color=#28282811
border-color=#4e4e4e11

width=450
height=200

border-radius=10
border-size=2

padding=12
outer-margin=0,0
margin=4

layer=overlay
anchor=top-right
max-history=128
max-visible=64
default-timeout=5000

max-icon-size=48
icon-border-radius=10

on-button-left=dismiss --no-history
on-button-right=dismiss
on-button-middle=exec makoctl menu -n "$id" rofi -dmenu
