window {
  width: 250px;
}

inputbar {
  enabled: false;
}

listview {
  columns: 1;
  lines: 3;
  padding: 8px;
  require-input: false;
}

element {
  children: [ element-text ];
  padding: 8px;
  width: 10px;
  border-radius: 4px;
}

element-text {
  horizontal-align: 0.5;
}

element-icon {
  enabled: false;
}
