{
  "workbench.editor.useModal": "off",
  "editor.inlayHints.enabled": "off",
  "settingsSync.keybindingsPerPlatform": false,
  "breadcrumbs.enabled": false,
  "debug.showInlineBreakpointCandidates": false,
  "errorLens.messageBackgroundMode": "message",
  "errorLens.enabledDiagnosticLevels": ["error", "info", "warning"],
  "editor.codeLens": false,
  "editor.cursorBlinking": "blink",
  "editor.cursorStyle": "line-thin",
  "editor.cursorSurroundingLines": 10,
  "editor.fontFamily": "JetBrainsMonoNL Nerd Font Mono",
  "terminal.integrated.fontFamily": "JetBrainsMonoNL Nerd Font Mono",
  "editor.fontLigatures": false,
  "editor.fontSize": 17,
  "editor.guides.indentation": false,
  "editor.lightbulb.enabled": "off",
  "editor.lineHeight": 1.45,
  "editor.lineNumbers": "relative",
  "editor.linkedEditing": true,
  "editor.minimap.enabled": false,
  "editor.overviewRulerBorder": false,
  "editor.renderWhitespace": "all",
  "editor.colorDecorators": true,
  "editor.renderLineHighlight": "line",
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.horizontalScrollbarSize": 0,
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.verticalScrollbarSize": 0,
  "editor.showFoldingControls": "never",
  "editor.stickyScroll.enabled": false,
  "editor.suggest.insertMode": "replace",
  "editor.tabSize": 2,
  "editor.wordWrap": "off",
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "extensions.ignoreRecommendations": true,
  "files.insertFinalNewline": true,
  "files.simpleDialog.enable": true,
  "files.trimTrailingWhitespace": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.openRepositoryInParentFolders": "never",
  "terminal.integrated.defaultLocation": "view",
  "security.workspace.trust.untrustedFiles": "open",
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.focusAfterRun": "terminal",
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.tabStopWidth": 2,
  "window.titleBarStyle": "native",
  "window.menuBarVisibility": "toggle",
  "vsicons.presets.hideExplorerArrows": true,
  "vsicons.dontShowNewVersionMessage": true,
  "window.commandCenter": false,
  "window.customMenuBarAltFocus": false,
  "window.density.editorTabHeight": "compact",
  "window.enableMenuBarMnemonics": false,
  "window.newWindowProfile": "Default",
  "workbench.layoutControl.enabled": false,
  "workbench.editor.revealIfOpen": true,
  "workbench.panel.defaultLocation": "bottom",
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.enablePreview": true,
  "workbench.editor.showTabs": "multiple",
  "workbench.iconTheme": "vscode-icons",
  "workbench.panel.opensMaximized": "preserve",
  "workbench.productIconTheme": "fluent-icons",
  "workbench.settings.editor": "json",
  "workbench.sideBar.location": "right",
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.tree.enableStickyScroll": false,
  "workbench.tree.indent": 24,
  "workbench.tree.renderIndentGuides": "none",
  "keyboard.dispatch": "keyCode",
  "chat.disableAIFeatures": true,
  "debug.closeReadonlyTabsOnEnd": true,
  "workbench.navigationControl.enabled": false,
  "window.systemColorTheme": "dark",
  "window.title": "${dirty} NeoCode",
  //! Affinity
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1,
  },
  //! VsCode Vim
  "vim.useSystemClipboard": true,
  "vim.leader": "<space>",
  "vim.useCtrlKeys": true,
  "vim.ignorecase": true,
  // Yanking
  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.duration": 150,
  "vim.highlightedyank.color": "#fce566",
  "vim.highlightedyank.textColor": "#222222",
  // Searching
  "vim.hlsearch": true,
  "vim.incsearch": true,
  "vim.searchHighlightColor": "#fce56680",
  "vim.searchHighlightTextColor": "#ffffff",
  // Plugins...
  "vim.surround": true,
  "vim.smartRelativeLine": true,
  // Keybinds
  "vim.handleKeys": {
    "<C-d>": true, // Example Key for Future
  },
  "vim.normalModeKeyBindingsNonRecursive": [
    // No highlighting
    {
      "before": ["<Esc>"],
      "when": ["editorFocus"],
      "commands": [":nohl"],
      "silent": true,
    },
    // Panes and Tabs
    {
      "before": ["<leader>", "p", "v"],
      "when": ["editorFocus"],
      "commands": [":vnew"],
      "silent": true,
    },
    {
      "before": ["<leader>", "p", "h"],
      "when": ["editorFocus"],
      "commands": [":new"],
      "silent": true,
    },
    // Files
    {
      "before": ["<leader>", "w"],
      "when": ["vim.mode == 'Normal' && editorTextFocus"],
      "commands": [":w"],
      "silent": true,
    },
    {
      "before": ["<leader>", "x"],
      "when": ["vim.mode == 'Normal' && editorTextFocus"],
      "commands": [":x"],
      "silent": true,
    },
    {
      "before": ["<leader>", "s", "f"],
      "when": ["vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"],
      "commands": ["workbench.action.quickOpen"],
      "silent": true,
    },
    {
      "before": ["<leader>", "f", "f"],
      "when": ["vim.mode == 'Normal' && (editorTextFocus || !inputFocus)"],
      "commands": ["editor.action.format"],
      "silent": true,
    },
    // Tree
    {
      "before": ["<leader>", "e"],
      "when": ["vim.mode == 'Normal' && (editorTextFocus || !inputFocus) && !sideBarFocus"],
      "commands": ["workbench.action.toggleSidebarVisibility", "workbench.files.action.focusFilesExplorer"],
      "silent": true,
    },
    {
      "before": ["<leader>", "n"],
      "commands": ["workbench.action.toggleSidebarVisibility"],
      "silent": true,
    },
    // LSP
    {
      "before": ["<leader>", "c", "a"],
      "commands": ["editor.action.codeAction"],
      // "when": "vim.mode == 'Normal' && editorTextFocus",
      "silent": true,
    },
    {
      "before": ["<leader>", "r", "n"],
      "commands": ["editor.action.rename"],
      // "when": "vim.mode == 'Normal' && editorHasRenameProvider && editorTextFocus && !editorReadonly",
      "silent": true,
    },
    {
      "before": ["<leader>", "g", "s"],
      "commands": ["workbench.action.gotoSymbol"],
      // "when": "vim.mode == 'Normal' && editorTextFocus",
      "silent": true,
    },
    {
      "before": ["<leader>", "g", "d"],
      "commands": ["editor.action.revealDefinition"],
      // "when": "vim.mode == 'Normal' && editorTextFocus",
      "silent": true,
    },
    {
      "before": ["<leader>", "g", "r"],
      "commands": ["editor.action.goToReferences"],
      // "when": "vim.mode == 'Normal' && editorTextFocus",
      "silent": true,
    },
    {
      "before": ["<leader>", "g", "i"],
      "commands": ["editor.action.goToImplementation"],
      // "when": "vim.mode == 'Normal' && editorTextFocus",
      "silent": true,
    },
    {
      "before": ["<leader>", "[", "d"],
      "commands": ["editor.action.marker.prev"],
      // "when": "vim.mode == 'Normal' && editorTextFocus",
      "silent": true,
    },
    {
      "before": ["<leader>", "]", "d"],
      "commands": ["editor.action.marker.nevercodeAction"],
      // "when": "vim.mode == 'Normal' && editorTextFocus",
      "silent": true,
    },
    {
      "before": ["<S-k>"],
      "commands": ["editor.action.showHover"],
      // "when": "vim.mode == 'Normal' && editorTextFocus",
      "silent": true,
    },
  ],
  "vim.insertModeKeyBindingsNonRecursive": [
    // Cursor Movement
    {
      "before": ["<C-h>"],
      "when": ["vim.mode == 'Insert'"],
      "commands": ["cursorLeft"],
      "silent": true,
    },
    {
      "before": ["<C-j>"],
      "when": ["vim.mode == 'Insert'"],
      "commands": ["cursorDown"],
      "silent": true,
    },
    {
      "before": ["<C-k>"],
      "when": ["vim.mode == 'Insert'"],
      "commands": ["cursorUp"],
      "silent": true,
    },
    {
      "before": ["<C-l>"],
      "when": ["vim.mode == 'Insert'"],
      "commands": ["cursorRight"],
      "silent": true,
    },
  ],
  // ! Prettier
  "prettier.printWidth": 180,
  "prettier.tabWidth": 2,
  "prettier.singleQuote": true,
  "prettier.jsxSingleQuote": true,
  "prettier.bracketSpacing": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  // ! Cpp / C
  "C_Cpp_Runner.cStandard": "c23",
  "C_Cpp_Runner.cppStandard": "c++23",
  "C_Cpp_Runner.useAddressSanitizer": true,
  "C_Cpp_Runner.useUndefinedSanitizer": true,
  "C_Cpp_Runner.useLeakSanitizer": true,
  "C_Cpp_Runner.useLinkTimeOptimization": true,
  "C_Cpp.clang_format_fallbackStyle": "LLVM",
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.path": "/home/ian/.config/Code/User/globalStorage/llvm-vs-code-extensions.vscode-clangd/install/22.1.0/clangd_22.1.0/bin/clangd",
  "[c]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
  },
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
  },
  // ! Workbench Customization
  "workbench.colorCustomizations": {
    "scrollbar.shadow": "#00000000",
    "terminal.background": "#222222",
    "panel.background": "#222222",
    "sideBar.background": "#222222",
    "sideBarSectionHeader.background": "#222222",
    "activityBar.background": "#222222",
    "statusBar.background": "#222222"
  },
  "workbench.colorTheme": "Monokai Pro (Filter Spectrum)",
  "redhat.telemetry.enabled": false,
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml",
  },
  "terminal.integrated.stickyScroll.enabled": false,
  "terminal.integrated.initialHint": false,
  "C_Cpp_Runner.cCompilerPath": "clang",
  "C_Cpp_Runner.cppCompilerPath": "clang++",
  "C_Cpp_Runner.warningsAsError": true,
  "terminal.integrated.tabs.enabled": false,
}
